[Unit]
Description=CIEM GPT 2027 (DeepSeek primario, Ollama .39 de respaldo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carlos
Group=carlos
WorkingDirectory=/var/www/ciem-2027/ciem-gpt
Environment=DEEPSEEK_API_URL=https://api.deepseek.com/anthropic
Environment=DEEPSEEK_MODEL=deepseek-flash
Environment=MODEL_LABEL=ciem-flash
Environment=DEEPSEEK_THINKING=disabled
Environment=OLLAMA_PRIMARY_URL=http://192.168.1.39:11434
Environment=OLLAMA_PRIMARY_MODEL=qwen2.5:0.5b
Environment=OLLAMA_FALLBACK_URL=http://127.0.0.1:11434
Environment=OLLAMA_FALLBACK_MODEL=qwen2.5:0.5b
Environment=PORT=8766
Environment=DB_FILE=/var/lib/ciem-gpt/quota.sqlite3
EnvironmentFile=-/etc/default/ciem-gpt
ExecStart=/usr/bin/python3 /var/www/ciem-2027/ciem-gpt/server/server.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/ciem-gpt
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
