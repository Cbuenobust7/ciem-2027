# Base URL of the backend API. Adjust it for each environment.
VITE_API_URL=http://localhost:8078

# Optional production analytics IDs; configure real values in frontend/.env.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=

# Optional public key when the Bricks flow is intentionally enabled.
# VITE_MP_BRICKS_PUBLIC_KEY=
